// manifest.json

{

  "manifest_version": 3,

  "name": "Choosr",

  "version": "1.0",

  "description": "Choosr allows you to optimize your shopping experience!",

  "permissions": [

    "activeTab"

  ],

  "background": {

    "service_worker": "sw.js",

    "persistent": false

  },

  "browser_action": {

    "default_popup": "popup.html"

  },

 "content_scripts": [

   {

     "matches": ["https://*.your-website.com/*"],

     "css": ["my-styles.css"],

     "js": ["content-script.js"]

   }

 ],




}

